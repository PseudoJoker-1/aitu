# Replace /home/deploy/aitu with your actual project path
# Replace 'deploy' with your actual system user

[Unit]
Description=Aitu.kz Django Backend (Gunicorn)
After=network.target

[Service]
User=deploy
Group=www-data
WorkingDirectory=/home/deploy/aitu/backend
EnvironmentFile=/home/deploy/aitu/backend/.env
ExecStart=/home/deploy/aitu/backend/venv/bin/gunicorn config.wsgi:application -c /home/deploy/aitu/deploy/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
