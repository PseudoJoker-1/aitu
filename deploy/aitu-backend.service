[Unit]
Description=Aitu.kz Django Backend (Gunicorn)
After=network.target

[Service]
User=__DEPLOY_USER__
Group=www-data
WorkingDirectory=__PROJECT_DIR__/backend
EnvironmentFile=__PROJECT_DIR__/backend/.env
ExecStart=__PROJECT_DIR__/backend/venv/bin/gunicorn config.wsgi:application -c __PROJECT_DIR__/deploy/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
